# Domain
MQTT_DOMAIN=mqtt.example.com

# Certbot
CERTBOT_EMAIL=admin@example.com
CERTBOT_ARGS=

# Container
CONTAINER_NAME=mqtt-broker
IMAGE_NAME=mqtt-broker-ws

# Ports
ACME_HTTP_PORT=80
MQTT_TLS_PORT=8883
MQTT_WS_TLS_PORT=443

# Paths on host
BASE_DIR=./runtime

# MQTT credentials
MQTT_USER=mqtt_user
MQTT_PASSWORD=change_this_password
